# name: NORMA YT-08
# family: tcp
# scope: youtube
# desc: fake,hostfakesplit, fooling=ts
# from: general (ALT3)
# Файл создан tools/gen_strategies.py; правки будут перезаписаны при повторной генерации.
--wf-tcp=443 --filter-tcp=443 --hostlist="%LISTS%list-google.txt" --ip-id=zero --dpi-desync=fake,hostfakesplit --dpi-desync-fake-tls-mod=rnd,dupsid,sni=www.google.com --dpi-desync-hostfakesplit-mod=host=www.google.com,altorder=1 --dpi-desync-fooling=ts
