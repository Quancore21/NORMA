# Образец собственной стратегии. Чтобы включить: переименуйте файл в my-strategy.args
# name: Моя стратегия 1
# scope: youtube
# desc: что делает эта стратегия (необязательно)
# Дальше аргументы winws одной или несколькими строками. Доступны подстановки %BIN% и %LISTS%.
--wf-tcp=443 --filter-tcp=443 --hostlist="%LISTS%list-google.txt" --ip-id=zero --dpi-desync=multisplit --dpi-desync-split-seqovl=681 --dpi-desync-split-pos=1 --dpi-desync-split-seqovl-pattern="%BIN%tls_clienthello_www_google_com.bin"
